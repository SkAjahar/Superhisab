<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ambient Shadow under 3D Book -->
    <path
        android:fillColor="#50000000"
        android:pathData="M31,81 L75,81 A5,5 0 0,1 80,86 L26,86 A5,5 0 0,1 31,81 Z" />

    <!-- Outer 3D Ledger Book Body with Gradient -->
    <path
        android:pathData="M37,25 L71,25 C76,25 80,29 80,34 L80,72 C80,77 76,81 71,81 L37,81 C32,81 28,77 28,72 L28,34 C28,29 32,25 37,25 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="28"
                android:startY="25"
                android:endX="80"
                android:endY="81"
                android:type="linear">
                <item android:offset="0.0" android:color="#059669" />
                <item android:offset="0.5" android:color="#047857" />
                <item android:offset="1.0" android:color="#064E3B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Book Spine 3D Shadow Strip (Left side) -->
    <path
        android:pathData="M37,25 L38,25 L38,81 L37,81 C32,81 28,77 28,72 L28,34 C28,29 32,25 37,25 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="28"
                android:startY="53"
                android:endX="38"
                android:endY="53"
                android:type="linear">
                <item android:offset="0.0" android:color="#022C22" />
                <item android:offset="0.7" android:color="#064E3B" />
                <item android:offset="1.0" android:color="#047857" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Metallic Gold Vertical Spine Rim / Stitching Line -->
    <path
        android:pathData="M38,25 L38,81"
        android:strokeColor="#F59E0B"
        android:strokeWidth="1.6" />

    <!-- Glassmorphic Top Sheen Highlight on Cover -->
    <path
        android:pathData="M38,25 L71,25 C76,25 80,29 80,34 L80,50 L38,36 Z"
        android:fillColor="#1FFFFFFF" />

    <!-- Hanging Royal Gold Bookmark Ribbon -->
    <path
        android:pathData="M61,25 L61,43 L66,39 L71,43 L71,25 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="61"
                android:startY="25"
                android:endX="71"
                android:endY="43"
                android:type="linear">
                <item android:offset="0.0" android:color="#FDE68A" />
                <item android:offset="0.4" android:color="#F59E0B" />
                <item android:offset="1.0" android:color="#D97706" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Center Emblem: Dark Obsidian Medallion Base -->
    <path
        android:pathData="M59,41 A15,15 0 1,1 58.9,41 Z"
        android:fillColor="#091410" />

    <!-- Center Emblem: Metallic Gold Border Ring -->
    <path
        android:pathData="M59,41 A15,15 0 1,1 58.9,41 Z"
        android:strokeWidth="2.0">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="44"
                android:startY="41"
                android:endX="74"
                android:endY="71"
                android:type="linear">
                <item android:offset="0.0" android:color="#FDE68A" />
                <item android:offset="0.5" android:color="#F59E0B" />
                <item android:offset="1.0" android:color="#B45309" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Embossed Crisp Gold Rupee (₹) Symbol -->
    <!-- Top Horizontal Bar -->
    <path
        android:pathData="M52,49 L66,49"
        android:strokeColor="#FEF08A"
        android:strokeWidth="2.0"
        android:strokeLineCap="round" />

    <!-- Second Horizontal Bar -->
    <path
        android:pathData="M52,53.5 L64,53.5"
        android:strokeColor="#FEF08A"
        android:strokeWidth="2.0"
        android:strokeLineCap="round" />

    <!-- Vertical Stem, Loop & Diagonal Leg -->
    <path
        android:pathData="M55.5,49 L55.5,60 C59.5,60 62.5,58.2 62.5,54.8 C62.5,51.5 59.5,49.5 55.5,49.5 M54.5,59.5 L64.5,67.5"
        android:strokeColor="#FEF08A"
        android:strokeWidth="2.0"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Floating Luxury Sparkle: 4-Point Star Top Right -->
    <path
        android:pathData="M78,28 Q78,32 82,32 Q78,32 78,36 Q78,32 74,32 Q78,32 78,28 Z"
        android:fillColor="#FDE68A" />

    <!-- Floating Subtle Sparkle: Bottom Left -->
    <path
        android:pathData="M24,68 Q24,70.5 26.5,70.5 Q24,70.5 24,73 Q24,70.5 21.5,70.5 Q24,70.5 24,68 Z"
        android:fillColor="#34D399" />
</vector>
